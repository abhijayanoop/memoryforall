{
  "version": 1,
  "description": "memoryforall build board",
  "project": { "owner": "abhijayanoop", "title": "Memoryforall board", "number": 1 },
  "worker_backend": "workflow",
  "host": "claude",
  "target": { "type": "repo", "url": null },
  "repo": { "path": ".", "remote": "https://github.com/abhijayanoop/memoryforall" },
  "base_branch": "staging",
  "timezone": "Asia/Kolkata",
  "columns": ["Backlog", "Ready", "Building", "QA", "Review", "Blocked", "Done"],
  "labels": ["qa", "bug", "feature"],
  "paths": { "project_md": "docs/super-board/PROJECT.md", "pre_flight_md": "docs/super-board/pre-flight.md", "runs_dir": "docs/super-board/runs" },
  "human_approves_merge": false,
  "merge_policy": { "default": "auto", "auto_max_lines": 400 },
  "migrations": { "allowed_envs": ["test", "staging"], "target_env": "staging", "commands": {} },
  "notifications": { "channel": "session", "bot_identity": "abhijayanoop" },
  "collect": { "sources": ["github"] },
  "verify_commands": [
    "cd server && uv sync --frozen && ruff check . && mypy . && pytest -q",
    "cd extension && npm ci --silent && npm run typecheck && npm test"
  ]
}
